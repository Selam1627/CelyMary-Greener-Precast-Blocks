# Copy this file to .env and fill in real values. Never commit .env.
# Variables starting with VITE_ are bundled into the public website code,
# so never put secrets in them.

# Company inbox: the contact form delivers messages here, and the website shows
# it as the "write to us directly" address. Public.
VITE_CONTACT_EMAIL=contact@example.com

# Secret. API key from Resend (resend.com), used by the server to send the
# contact form. Set it here for local testing and in the Vercel project settings.
RESEND_API_KEY=

# Sender shown on contact form emails. Without a verified domain, Resend only
# allows its test sender, and only delivers to your Resend account's address.
CONTACT_FROM_EMAIL=CelyMary website <onboarding@resend.dev>

# Ports on your computer for the dev server and the preview server
# (docker compose only). Change them if another app already uses them.
DEV_PORT=5173
PREVIEW_PORT=4173
